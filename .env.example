# Copy to .env and fill in. Nothing here has a working default in production:
# with SABI_ADMIN_TOKEN unset the admin routes return 404 rather than shipping
# a default credential.

SABI_DATABASE_URL=postgresql+psycopg://sabi:sabi@localhost:5433/sabi

# Providers. "offline" and "local_lsa" need no API key and no network: the whole
# system, including the eval harness, runs deterministically without them.
# Set to "anthropic" / "voyage" with the matching key for real inference.
SABI_LLM_PROVIDER=offline
SABI_EMBEDDING_PROVIDER=local_lsa
SABI_EMBEDDING_DIM=256
# SABI_ANTHROPIC_API_KEY=
# SABI_VOYAGE_API_KEY=

# Required for the admin surface to exist at all.
SABI_ADMIN_TOKEN=

# Used to salt the one-way hash of client IPs. Raw IPs are never stored.
SABI_IP_HASH_SALT=change-me

# Signs the anonymous id cookie and derives CSRF tokens. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out. Must be set in production.
SABI_SECRET_KEY=change-me

# How long a login survives without use.
SABI_SESSION_DAYS=30

SABI_ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Third-party accounts — every one deliberately BLANK.
#
# The owner opens these accounts and supplies the keys; nothing here signs up
# for anything. Each seam is built and tested against a fake, so the feature
# works the day a key arrives and no other work waits on one.
#
# The rule that applies to all of them, carried from v1: a capability with no
# key does not half-work. It reports plainly that it is unavailable and offers
# whatever still works. `NoVisionClient` is the worked example -- with no
# vision key the photo page says Sabi cannot read photos here and offers the
# composer, rather than showing an upload box that cannot function.
# ---------------------------------------------------------------------------

# -- the answering and tutor model ------------------------------------------
# Until this exists the offline extractive provider serves every answer, and
# every groundedness and correctness number is a tautology under it. Set a
# monthly spending limit in the Anthropic console; the app's own budget kill
# switch (config/limits.yaml: budget.monthly_ceiling_usd) sits BELOW it.
# SABI_ANTHROPIC_API_KEY=

# -- embeddings --------------------------------------------------------------
# Changing the embedding provider rebuilds every vector and invalidates every
# swept threshold. `sabi reindex`, then re-sweep. Never a silent switch.
# SABI_VOYAGE_API_KEY=

# -- payments (Phase 8) ------------------------------------------------------
# Paystack test mode until Phase 8. The webhook is verified with the SECRET
# key, not a separate webhook secret, over the RAW request body.
# Starter Business has a lifetime collection cap of NGN 8,000,000; the admin
# alert fires at 75% because CAC registration and the compliance upgrade are
# multi-week processes.
# SABI_PAYSTACK_PUBLIC_KEY=
# SABI_PAYSTACK_SECRET_KEY=
# SABI_PAYSTACK_WEBHOOK_TOLERANCE_SECONDS=300

# -- SMS, for guardian consent (Phase 3) -------------------------------------
# Over 30 million Nigerian numbers sit on the NCC Do-Not-Disturb list, so a
# consent code sent on a generic route silently fails for a large share of
# guardians. The provider must have DND/transactional route access and a
# whitelisted sender ID -- per-operator registration takes weeks and needs CAC.
# SABI_SMS_PROVIDER=
# SABI_SMS_API_KEY=
# SABI_SMS_SENDER_ID=

# -- transactional email (Phase 3) -------------------------------------------
# SABI_EMAIL_PROVIDER=
# SABI_EMAIL_API_KEY=
# SABI_EMAIL_FROM=

# -- error reporting (optional, Phase 9) -------------------------------------
# First-party or self-hosted only: no third-party analytics on a page aimed at
# minors, and no student question text in a crash report.
# SABI_ERROR_DSN=
